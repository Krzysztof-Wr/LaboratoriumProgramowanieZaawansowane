<Window x:Class="QuizWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuizWpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="663" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- LEWA STRONA -->
        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Tytuł quizu:" Margin="0,0,0,5"/>
            <TextBox x:Name="TitleTextBox" Margin="0,0,0,10"/>

            <TextBlock Text="Opis quizu:" Margin="0,0,0,5"/>
            <TextBox x:Name="DescriptionTextBox"
                 Height="100"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Margin="0,0,0,10"/>

            <Button x:Name="AddQuizButton"
                Content="Dodaj quiz (do bazy)"
                Height="30"
                Width="160"
                Click="AddQuizButton_Click"/>
        </StackPanel>

        <!-- PRAWA STRONA -->
        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Quizy w bazie:" Margin="0,0,0,5" FontWeight="Bold"/>

            <ListBox x:Name="QuizListBox" Height="51" SelectionChanged="QuizListBox_SelectionChanged"/>

            <Button Content="Odśwież listę"
                Height="30"
                Width="120"
                Margin="0,10,0,0"
                Click="RefreshButton_Click"/>
            <TextBlock Text="Pytania wybranego quizu:" Margin="0,10,0,5" FontWeight="Bold"/>
            <ListBox x:Name="QuestionListBox" Height="120" DisplayMemberPath="Text"
         SelectionChanged="QuestionListBox_SelectionChanged"/>

            <TextBox x:Name="QuestionTextBox" Margin="0,5,0,5" />
            <Button Content="Dodaj pytanie" Height="28" Width="120"
        Click="AddQuestionButton_Click"/>

            <TextBlock Text="Odpowiedzi wybranego pytania:" Margin="0,10,0,5" FontWeight="Bold"/>
            <ListBox x:Name="AnswerListBox" Height="120" DisplayMemberPath="Text"/>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBox x:Name="AnswerTextBox" Width="220" Margin="0,0,10,0"/>
                <CheckBox x:Name="IsCorrectCheckBox" Content="Poprawna"/>
            </StackPanel>

            <Button Content="Dodaj odpowiedź" Height="28" Width="140" Margin="0,5,0,0"
        Click="AddAnswerButton_Click"/>

        </StackPanel>
    </Grid>

</Window>
